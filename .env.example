# Copy to .env and edit. Only DOMAIN and APP_URL are needed for a normal VPS install.

# Your domain, with a DNS A record pointing at this server.
DOMAIN=help.example.com

# The full public address people use to open Ansa. Links in emails, the live chat embed code and open
# tracking use it. An example.com address is ignored. On Cloudflare, leave it out: Ansa uses the address
# you sign in on.
APP_URL=https://help.example.com

# --- Optional ---------------------------------------------------------------
# Host port and bind address for the app container. Use BIND=0.0.0.0 only when
# another reverse proxy on a different machine needs to reach it.
# PORT=3000
# BIND=127.0.0.1

# Seconds between inbox checks when the mail server cannot push new mail.
# IMAP_POLL_SECONDS=60

# Largest attachment an agent can upload, in MB. Gmail's own limit is 25.
# MAX_ATTACHMENT_MB=25
